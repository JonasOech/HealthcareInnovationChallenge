{
  // Worker that serves the built deck and runs the live session (worker.js).
  // `node build-deck.mjs` writes dist/ (about 190 files, 18 MB); without the assets directory
  // wrangler would upload the whole folder, node_modules included.
  // The presenter key is a secret: `npx wrangler secret put PRESENTER_KEY`.
  "name": "healthcareinnovationchallenge",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "assets": { "directory": "dist", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "Live" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Live"] }]
}
